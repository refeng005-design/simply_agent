# Simply Agent Backend - 环境变量配置模板
# 复制此文件为 .env 并根据需要修改值

# ==================== 应用配置 ====================

# Flask 运行环境: development | production
FLASK_ENV=development

# 应用密钥 (用于session加密等，生产环境必须修改)
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# API 服务端口
API_PORT=5000

# ==================== 数据库配置 ====================

# 数据库连接 URL
# SQLite: sqlite:///simply_agent.db
# MySQL: mysql://user:password@localhost:3306/dbname
# PostgreSQL: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///simply_agent.db

# ==================== LLM API 配置 ====================

# OpenAI API 配置
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API 配置
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 通义千问 API 配置
QWEN_API_KEY=your-qwen-api-key-here

# ==================== 向量数据库配置 ====================

# Chroma 向量数据库配置
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ==================== Docker 部署配置 ====================

# 前端服务端口
FRONTEND_PORT=80

# ==================== MySQL 配置 (可选) ====================

# MySQL 端口 (仅在启用 MySQL 服务时需要)
MYSQL_PORT=3306

# MySQL root 密码
MYSQL_ROOT_PASSWORD=rootpassword

# MySQL 数据库名
MYSQL_DATABASE=simply_agent

# MySQL 用户名
MYSQL_USER=simply_agent

# MySQL 密码
MYSQL_PASSWORD=agentpassword

# ==================== PostgreSQL 配置 (可选) ====================

# PostgreSQL 端口 (仅在启用 PostgreSQL 服务时需要)
POSTGRES_PORT=5432

# PostgreSQL 数据库名
POSTGRES_DB=simply_agent

# PostgreSQL 用户名
POSTGRES_USER=simply_agent

# PostgreSQL 密码
POSTGRES_PASSWORD=agentpassword
